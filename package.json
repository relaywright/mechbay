{
  "name": "mechbay",
  "version": "1.4.2",
  "description": "A BattleTech-inspired command bay for AI coding agents: deploy Claude Code, Codex and other CLI agents as mechs into your real project folders",
  "main": "./out/main/index.js",
  "author": "Sam Albanese <samalbanesedev@gmail.com>",
  "homepage": "https://github.com/samalbanese/mechbay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samalbanese/mechbay.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "demo": "cross-env MECHBAY_DEMO=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "test:real-cli": "cross-env MECHBAY_REAL_CLI=1 vitest run test/acceptance",
    "test:watch": "vitest",
    "smoke:electron": "npm run build && node --experimental-strip-types scripts/smoke-electron.ts",
    "verify:missions": "npm run build && node --experimental-strip-types scripts/verify-missions.ts",
    "capture:demo": "node scripts/capture-demo.mjs",
    "capture:portfolio": "npm run build && node --experimental-strip-types scripts/capture-portfolio.ts && node --experimental-strip-types scripts/export-portfolio.ts",
    "chromakey": "node --experimental-strip-types scripts/chromakey.ts assets/mechs && node --experimental-strip-types scripts/chromakey.ts assets/facilities",
    "forge:sprites": "node --experimental-strip-types scripts/sprite-forge.ts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "cross-spawn": "^7.0.6",
    "electron-store": "^11.0.2",
    "ulid": "^2.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^20.14.5",
    "jimp": "^1.6.1",
    "mitt": "^3.0.1",
    "phaser": "^3.90.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.2"
  }
}
