// Cloudflare Workers static-asset config for the landing page.
// The connected CI deploy runs `npx wrangler deploy`, which publishes the
// pre-built site/ folder as-is, with no build step.
{
  "name": "mechbay",
  "compatibility_date": "2026-07-18",
  "assets": {
    "directory": "./site"
  },
  // Custom domain on a zone in the same Cloudflare account.
  // workers.dev stays on so older links keep working.
  "routes": [{ "pattern": "mechbay.samalbanese.com", "custom_domain": true }],
  "workers_dev": true
}
